# Copy this file to C:\Users\eduar\tpl-brain-secrets\.env and fill in real values.
# Never fill in real values here -- this file lives inside the Drive-synced folder.

SUPABASE_URL=https://hjmstjhighgazkfbrmqa.supabase.co
# Settings > API > service_role secret key (bypasses RLS -- backend/server use only)
SUPABASE_SERVICE_KEY=

# Reddit "script" app -- create at https://www.reddit.com/prefs/apps (type: script)
# Currently pending Reddit's approval -- pipeline runs fine without it, just
# skips the Reddit source until these are filled in.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=TPL_brain research agent by u/YOUR_REDDIT_USERNAME

# YouTube Data API v3 (official, free, no OAuth) -- enable the API and create
# a key at https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# Apify token -- https://console.apify.com/settings/integrations
# Reserved for Instagram/TikTok (no free official API). Free plan = $5/month
# credits, no rollover -- collectors/apify_collector.py enforces a hard
# max_items cap per run so nothing silently burns the whole month.
APIFY_TOKEN=

# Which LLM backend extraction/llm_client.py uses. Default: gemini (free).
# One of: gemini | groq | anthropic
TPL_LLM_PROVIDER=gemini

# Fill in ONLY the key for the provider above.

# Gemini (default, free, no credit card) -- https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq (free, no credit card, open-weight models) -- https://console.groq.com/keys
GROQ_API_KEY=

# Anthropic (paid, no free tier) -- https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional model override -- defaults per provider are set in config.py
TPL_LLM_MODEL=
